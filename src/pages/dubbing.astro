---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AniDub AI - Dubbing Studio">
  <main class="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-blue-900">
    <!-- Header -->
    <header class="bg-black bg-opacity-50 backdrop-blur-lg border-b border-purple-500">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <h1 class="text-2xl font-bold text-white">AniDub AI Studio</h1>
          <div class="text-sm text-gray-300">Professional Anime Dubbing</div>
        </div>
        <div class="flex items-center space-x-4">
          <button id="save-project" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition-colors">
            💾 Save Project
          </button>
          <button id="export-video" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
            📥 Export Video
          </button>
        </div>
      </div>
    </header>

    <div class="flex h-screen">
      <!-- Left Sidebar - Upload & Settings -->
      <aside class="w-80 bg-black bg-opacity-30 backdrop-blur-lg border-r border-purple-500 overflow-y-auto">
        <div class="p-6 space-y-6">
          <!-- Upload Section -->
          <div class="bg-white bg-opacity-10 rounded-xl p-6">
            <h3 class="text-lg font-bold text-white mb-4">📁 Upload Content</h3>
            
            <div id="upload-area" class="border-2 border-dashed border-purple-400 rounded-lg p-8 text-center cursor-pointer hover:border-purple-300 transition-colors">
              <div class="text-4xl mb-4">🎬</div>
              <div class="text-white font-semibold mb-2">Drop anime video here</div>
              <div class="text-gray-400 text-sm">or click to browse</div>
              <input type="file" id="video-upload" accept="video/*" class="hidden">
            </div>

            <div class="mt-4">
              <label class="block text-white text-sm font-medium mb-2">Or paste URL:</label>
              <input type="url" id="video-url" placeholder="https://example.com/anime.mp4" 
                     class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
            </div>
          </div>

          <!-- Language Settings -->
          <div class="bg-white bg-opacity-10 rounded-xl p-6">
            <h3 class="text-lg font-bold text-white mb-4">🌍 Language Settings</h3>
            
            <div class="space-y-4">
              <div>
                <label class="block text-white text-sm font-medium mb-2">Source Language:</label>
                <select id="source-language" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                  <option value="ja">Japanese</option>
                  <option value="en">English</option>
                  <option value="ko">Korean</option>
                  <option value="zh">Chinese</option>
                </select>
              </div>

              <div>
                <label class="block text-white text-sm font-medium mb-2">Target Language:</label>
                <select id="target-language" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                  <option value="en">English</option>
                  <option value="hi">Hindi</option>
                  <option value="ta">Tamil</option>
                  <option value="es">Spanish</option>
                  <option value="fr">French</option>
                  <option value="de">German</option>
                  <option value="it">Italian</option>
                  <option value="pt">Portuguese</option>
                  <option value="ru">Russian</option>
                  <option value="zh">Chinese</option>
                  <option value="ko">Korean</option>
                  <option value="ar">Arabic</option>
                </select>
              </div>

              <div>
                <label class="block text-white text-sm font-medium mb-2">Regional Accent:</label>
                <select id="regional-accent" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                  <option value="us_english">US English</option>
                  <option value="uk_english">UK English</option>
                  <option value="australian_english">Australian English</option>
                  <option value="indian_english">Indian English</option>
                  <option value="canadian_english">Canadian English</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Quality Settings -->
          <div class="bg-white bg-opacity-10 rounded-xl p-6">
            <h3 class="text-lg font-bold text-white mb-4">⚙️ Quality Settings</h3>
            
            <div class="space-y-4">
              <div>
                <label class="block text-white text-sm font-medium mb-2">Quality Preset:</label>
                <select id="quality-preset" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                  <option value="fast">Fast (Preview)</option>
                  <option value="balanced" selected>Balanced (Recommended)</option>
                  <option value="high_quality">High Quality (Slow)</option>
                </select>
              </div>

              <div>
                <label class="block text-white text-sm font-medium mb-2">Lip Sync Accuracy:</label>
                <select id="lip-sync-accuracy" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                  <option value="standard">Standard</option>
                  <option value="high" selected>High</option>
                  <option value="ultra">Ultra (Slower)</option>
                </select>
              </div>

              <div>
                <label class="block text-white text-sm font-medium mb-2">Emotion Intensity:</label>
                <div class="flex items-center space-x-2">
                  <span class="text-gray-400 text-xs">Low</span>
                  <input type="range" id="emotion-intensity" min="1" max="4" value="2" 
                         class="flex-1 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">
                  <span class="text-gray-400 text-xs">Ultra</span>
                </div>
                <div class="text-center text-white text-sm mt-1" id="emotion-level">Medium</div>
              </div>

              <div class="flex items-center justify-between">
                <label class="text-white text-sm font-medium">Enable Subtitles:</label>
                <input type="checkbox" id="enable-subtitles" checked 
                       class="w-4 h-4 text-purple-600 bg-gray-700 border-gray-600 rounded focus:ring-purple-500">
              </div>
            </div>
          </div>

          <!-- Start Processing Button -->
          <button id="start-processing" disabled 
                  class="w-full bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 disabled:from-gray-600 disabled:to-gray-700 text-white font-bold py-4 px-6 rounded-xl text-lg transition-all duration-300 transform hover:scale-105 disabled:transform-none disabled:cursor-not-allowed">
            🚀 Start Dubbing Process
          </button>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex-1 flex flex-col">
        <!-- Video Player -->
        <div class="bg-black bg-opacity-50 p-6 border-b border-purple-500">
          <div class="max-w-4xl mx-auto">
            <div id="video-container" class="relative bg-black rounded-xl overflow-hidden aspect-video">
              <div id="video-placeholder" class="absolute inset-0 flex items-center justify-center text-gray-400">
                <div class="text-center">
                  <div class="text-6xl mb-4">🎬</div>
                  <div class="text-xl">Upload a video to get started</div>
                </div>
              </div>
              <video id="main-video" class="w-full h-full hidden" controls>
                Your browser does not support the video tag.
              </video>
            </div>

            <!-- Video Controls -->
            <div class="mt-4 flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <button id="play-pause" class="bg-purple-600 hover:bg-purple-700 text-white p-2 rounded-lg transition-colors">
                  ▶️
                </button>
                <div class="text-white text-sm">
                  <span id="current-time">00:00</span> / <span id="total-time">00:00</span>
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-white text-sm">Volume:</span>
                <input type="range" id="volume-control" min="0" max="100" value="50" 
                       class="w-20 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">
              </div>
            </div>
          </div>
        </div>

        <!-- Progress & Status -->
        <div class="bg-black bg-opacity-30 p-6 border-b border-purple-500">
          <div class="max-w-4xl mx-auto">
            <div id="processing-status" class="hidden">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white">Processing Status</h3>
                <div class="text-sm text-gray-400" id="estimated-time">Estimated: --:--</div>
              </div>
              
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-white text-sm">Overall Progress:</span>
                  <span class="text-purple-400 text-sm font-medium" id="overall-percentage">0%</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2">
                  <div id="overall-progress" class="bg-gradient-to-r from-pink-500 to-purple-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                
                <div class="text-white text-sm" id="current-stage">Ready to start...</div>
                
                <!-- Stage Progress Indicators -->
                <div class="grid grid-cols-5 gap-2 mt-4">
                  <div class="text-center">
                    <div id="stage-upload" class="w-8 h-8 rounded-full bg-gray-600 mx-auto mb-1 flex items-center justify-center text-xs">1</div>
                    <div class="text-xs text-gray-400">Upload</div>
                  </div>
                  <div class="text-center">
                    <div id="stage-analysis" class="w-8 h-8 rounded-full bg-gray-600 mx-auto mb-1 flex items-center justify-center text-xs">2</div>
                    <div class="text-xs text-gray-400">Analysis</div>
                  </div>
                  <div class="text-center">
                    <div id="stage-translation" class="w-8 h-8 rounded-full bg-gray-600 mx-auto mb-1 flex items-center justify-center text-xs">3</div>
                    <div class="text-xs text-gray-400">Translation</div>
                  </div>
                  <div class="text-center">
                    <div id="stage-synthesis" class="w-8 h-8 rounded-full bg-gray-600 mx-auto mb-1 flex items-center justify-center text-xs">4</div>
                    <div class="text-xs text-gray-400">Voice Synthesis</div>
                  </div>
                  <div class="text-center">
                    <div id="stage-finalization" class="w-8 h-8 rounded-full bg-gray-600 mx-auto mb-1 flex items-center justify-center text-xs">5</div>
                    <div class="text-xs text-gray-400">Finalization</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Character Voice Assignment -->
        <div class="flex-1 bg-black bg-opacity-20 p-6 overflow-y-auto">
          <div class="max-w-4xl mx-auto">
            <h3 class="text-lg font-bold text-white mb-6">🎭 Character Voice Assignment</h3>
            
            <div id="character-list" class="space-y-4">
              <!-- Characters will be populated here after analysis -->
              <div class="text-center text-gray-400 py-12">
                <div class="text-4xl mb-4">🤖</div>
                <div>Characters will appear here after video analysis</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Sidebar - Voice Library -->
      <aside class="w-80 bg-black bg-opacity-30 backdrop-blur-lg border-l border-purple-500 overflow-y-auto">
        <div class="p-6">
          <h3 class="text-lg font-bold text-white mb-6">🎤 Voice Library</h3>
          
          <!-- Voice Filters -->
          <div class="mb-6 space-y-4">
            <div>
              <label class="block text-white text-sm font-medium mb-2">Filter by Gender:</label>
              <select id="voice-gender-filter" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                <option value="">All</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
              </select>
            </div>
            
            <div>
              <label class="block text-white text-sm font-medium mb-2">Filter by Age:</label>
              <select id="voice-age-filter" class="w-full bg-gray-800 text-white rounded-lg px-3 py-2 border border-gray-600 focus:border-purple-400 focus:outline-none">
                <option value="">All</option>
                <option value="child">Child</option>
                <option value="teen">Teen</option>
                <option value="adult">Adult</option>
                <option value="elderly">Elderly</option>
              </select>
            </div>
          </div>

          <!-- Voice List -->
          <div id="voice-list" class="space-y-3">
            <!-- Default voice options -->
            <div class="voice-option bg-white bg-opacity-10 rounded-lg p-4 cursor-pointer hover:bg-opacity-20 transition-colors" data-voice-id="male_young_energetic">
              <div class="flex items-center justify-between mb-2">
                <span class="text-white font-semibold">Young Male (Energetic)</span>
                <button class="voice-test-btn text-purple-400 hover:text-purple-300 text-sm">▶️ Test</button>
              </div>
              <div class="text-gray-400 text-xs">Perfect for shounen protagonists</div>
              <div class="flex items-center mt-2 space-x-1">
                <span class="bg-blue-600 text-white text-xs px-2 py-1 rounded">Male</span>
                <span class="bg-green-600 text-white text-xs px-2 py-1 rounded">Teen</span>
                <span class="bg-purple-600 text-white text-xs px-2 py-1 rounded">Energetic</span>
              </div>
            </div>

            <div class="voice-option bg-white bg-opacity-10 rounded-lg p-4 cursor-pointer hover:bg-opacity-20 transition-colors" data-voice-id="female_young_cute">
              <div class="flex items-center justify-between mb-2">
                <span class="text-white font-semibold">Young Female (Cute)</span>
                <button class="voice-test-btn text-purple-400 hover:text-purple-300 text-sm">▶️ Test</button>
              </div>
              <div class="text-gray-400 text-xs">Ideal for moe characters</div>
              <div class="flex items-center mt-2 space-x-1">
                <span class="bg-pink-600 text-white text-xs px-2 py-1 rounded">Female</span>
                <span class="bg-green-600 text-white text-xs px-2 py-1 rounded">Teen</span>
                <span class="bg-purple-600 text-white text-xs px-2 py-1 rounded">Cute</span>
              </div>
            </div>

            <div class="voice-option bg-white bg-opacity-10 rounded-lg p-4 cursor-pointer hover:bg-opacity-20 transition-colors" data-voice-id="male_adult_calm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-white font-semibold">Adult Male (Calm)</span>
                <button class="voice-test-btn text-purple-400 hover:text-purple-300 text-sm">▶️ Test</button>
              </div>
              <div class="text-gray-400 text-xs">Great for wise mentors</div>
              <div class="flex items-center mt-2 space-x-1">
                <span class="bg-blue-600 text-white text-xs px-2 py-1 rounded">Male</span>
                <span class="bg-orange-600 text-white text-xs px-2 py-1 rounded">Adult</span>
                <span class="bg-teal-600 text-white text-xs px-2 py-1 rounded">Calm</span>
              </div>
            </div>

            <div class="voice-option bg-white bg-opacity-10 rounded-lg p-4 cursor-pointer hover:bg-opacity-20 transition-colors" data-voice-id="female_adult_standard">
              <div class="flex items-center justify-between mb-2">
                <span class="text-white font-semibold">Adult Female (Standard)</span>
                <button class="voice-test-btn text-purple-400 hover:text-purple-300 text-sm">▶️ Test</button>
              </div>
              <div class="text-gray-400 text-xs">Versatile for any character</div>
              <div class="flex items-center mt-2 space-x-1">
                <span class="bg-pink-600 text-white text-xs px-2 py-1 rounded">Female</span>
                <span class="bg-orange-600 text-white text-xs px-2 py-1 rounded">Adult</span>
                <span class="bg-gray-600 text-white text-xs px-2 py-1 rounded">Standard</span>
              </div>
            </div>
          </div>

          <!-- Custom Voice Upload -->
          <div class="mt-6 pt-6 border-t border-purple-500">
            <h4 class="text-white font-semibold mb-4">🎯 Custom Voice Training</h4>
            <div class="bg-white bg-opacity-10 rounded-lg p-4">
              <div class="text-gray-400 text-sm mb-3">Upload voice samples for custom training:</div>
              <input type="file" id="voice-samples" multiple accept="audio/*" 
                     class="w-full text-white text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-purple-600 file:text-white hover:file:bg-purple-700">
              <button id="train-voice" class="w-full mt-3 bg-purple-600 hover:bg-purple-700 text-white py-2 px-4 rounded-lg text-sm transition-colors">
                Train Custom Voice
              </button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<script>
  // Dubbing Studio JavaScript
  document.addEventListener('DOMContentLoaded', () => {
    // Element references
    const uploadArea = document.getElementById('upload-area');
    const videoUpload = document.getElementById('video-upload');
    const videoUrl = document.getElementById('video-url');
    const mainVideo = document.getElementById('main-video');
    const videoPlaceholder = document.getElementById('video-placeholder');
    const startProcessingBtn = document.getElementById('start-processing');
    const processingStatus = document.getElementById('processing-status');
    const emotionIntensity = document.getElementById('emotion-intensity');
    const emotionLevel = document.getElementById('emotion-level');

    // State management
    let currentProject = {
      videoFile: null,
      settings: {
        sourceLanguage: 'ja',
        targetLanguage: 'en',
        qualityPreset: 'balanced',
        lipSyncAccuracy: 'high',
        emotionIntensity: 'medium',
        subtitlesEnabled: true
      },
      characters: [],
      processing: false
    };

    // File upload handling
    uploadArea.addEventListener('click', () => {
      videoUpload.click();
    });

    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('border-purple-300');
    });

    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('border-purple-300');
    });

    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('border-purple-300');
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        handleVideoFile(files[0]);
      }
    });

    videoUpload.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleVideoFile(e.target.files[0]);
      }
    });

    // Handle video file
    function handleVideoFile(file) {
      if (!file.type.startsWith('video/')) {
        alert('Please select a valid video file.');
        return;
      }

      currentProject.videoFile = file;
      currentProject.videoKey = null; // Will be set after upload
      const videoUrl = URL.createObjectURL(file);
      
      mainVideo.src = videoUrl;
      mainVideo.classList.remove('hidden');
      videoPlaceholder.classList.add('hidden');
      startProcessingBtn.disabled = false;

      // Simulate character detection
      setTimeout(() => {
        detectCharacters();
      }, 2000);
    }

    // Emotion intensity slider
    emotionIntensity.addEventListener('input', (e) => {
      const levels = ['Low', 'Medium', 'High', 'Ultra'];
      emotionLevel.textContent = levels[e.target.value - 1];
      currentProject.settings.emotionIntensity = levels[e.target.value - 1].toLowerCase();
    });

    // Character detection simulation
    function detectCharacters() {
      const characters = [
        { id: 'char1', name: 'Protagonist', gender: 'male', age: 'teen', voiceId: 'male_young_energetic' },
        { id: 'char2', name: 'Heroine', gender: 'female', age: 'teen', voiceId: 'female_young_cute' },
        { id: 'char3', name: 'Mentor', gender: 'male', age: 'adult', voiceId: 'male_adult_calm' }
      ];

      currentProject.characters = characters;
      renderCharacters();
    }

    // Render character list
    function renderCharacters() {
      const characterList = document.getElementById('character-list');
      characterList.innerHTML = '';

      currentProject.characters.forEach(character => {
        const characterDiv = document.createElement('div');
        characterDiv.className = 'bg-white bg-opacity-10 rounded-lg p-4';
        characterDiv.innerHTML = `
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-3">
              <div class="w-12 h-12 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full flex items-center justify-center text-white font-bold">
                ${character.name.charAt(0)}
              </div>
              <div>
                <div class="text-white font-semibold">${character.name}</div>
                <div class="text-gray-400 text-sm">${character.gender} • ${character.age}</div>
              </div>
            </div>
            <button class="assign-voice-btn bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded text-sm transition-colors" data-character-id="${character.id}">
              Assign Voice
            </button>
          </div>
          <div class="text-gray-300 text-sm">
            Current Voice: <span class="text-purple-400">${getVoiceName(character.voiceId)}</span>
          </div>
        `;
        characterList.appendChild(characterDiv);
      });

      // Add event listeners for voice assignment
      document.querySelectorAll('.assign-voice-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const characterId = e.target.dataset.characterId;
          openVoiceAssignmentModal(characterId);
        });
      });
    }

    // Get voice name by ID
    function getVoiceName(voiceId) {
      const voiceNames = {
        'male_young_energetic': 'Young Male (Energetic)',
        'female_young_cute': 'Young Female (Cute)',
        'male_adult_calm': 'Adult Male (Calm)',
        'female_adult_standard': 'Adult Female (Standard)'
      };
      return voiceNames[voiceId] || 'Unknown Voice';
    }

    // Voice assignment modal (simplified)
    function openVoiceAssignmentModal(characterId) {
      alert(`Voice assignment modal would open for character: ${characterId}`);
    }

    // Start processing
    startProcessingBtn.addEventListener('click', () => {
      if (!currentProject.videoFile) {
        alert('Please upload a video file first.');
        return;
      }

      startDubbingProcess();
    });

    // Dubbing process simulation
    function startDubbingProcess() {
      currentProject.processing = true;
      processingStatus.classList.remove('hidden');
      startProcessingBtn.disabled = true;
      startProcessingBtn.textContent = '⏳ Processing...';

      const stages = [
        { id: 'upload', name: 'Uploading and analyzing video...', duration: 2000 },
        { id: 'analysis', name: 'Extracting dialogue and characters...', duration: 3000 },
        { id: 'translation', name: 'Translating with cultural context...', duration: 4000 },
        { id: 'synthesis', name: 'Generating AI voices...', duration: 5000 },
        { id: 'finalization', name: 'Applying lip sync and mixing audio...', duration: 3000 }
      ];

      let currentStageIndex = 0;
      let overallProgress = 0;

      function processNextStage() {
        if (currentStageIndex >= stages.length) {
          // Processing complete
          document.getElementById('current-stage').textContent = 'Dubbing complete! 🎉';
          document.getElementById('overall-percentage').textContent = '100%';
          document.getElementById('overall-progress').style.width = '100%';
          startProcessingBtn.textContent = '✅ Complete';
          currentProject.processing = false;
          return;
        }

        const stage = stages[currentStageIndex];
        document.getElementById('current-stage').textContent = stage.name;
        
        // Update stage indicator
        const stageElement = document.getElementById(`stage-${stage.id}`);
        stageElement.classList.add('bg-purple-600', 'text-white');
        stageElement.classList.remove('bg-gray-600');

        // Simulate progress
        const progressIncrement = 100 / stages.length;
        const targetProgress = (currentStageIndex + 1) * progressIncrement;
        
        const progressInterval = setInterval(() => {
          overallProgress += 2;
          if (overallProgress >= targetProgress) {
            overallProgress = targetProgress;
            clearInterval(progressInterval);
            
            // Mark stage as complete
            stageElement.innerHTML = '✓';
            stageElement.classList.add('bg-green-600');
            stageElement.classList.remove('bg-purple-600');
            
            currentStageIndex++;
            setTimeout(processNextStage, 500);
          }
          
          document.getElementById('overall-percentage').textContent = `${Math.round(overallProgress)}%`;
          document.getElementById('overall-progress').style.width = `${overallProgress}%`;
        }, 100);
      }

      processNextStage();
    }

    // Voice testing
    document.querySelectorAll('.voice-test-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const voiceOption = e.target.closest('.voice-option');
        const voiceId = voiceOption.dataset.voiceId;
        
        // Simulate voice test
        btn.textContent = '⏸️ Stop';
        setTimeout(() => {
          btn.textContent = '▶️ Test';
        }, 3000);
      });
    });

    // Video controls
    const playPauseBtn = document.getElementById('play-pause');
    const volumeControl = document.getElementById('volume-control');

    playPauseBtn?.addEventListener('click', () => {
      if (mainVideo.paused) {
        mainVideo.play();
        playPauseBtn.textContent = '⏸️';
      } else {
        mainVideo.pause();
        playPauseBtn.textContent = '▶️';
      }
    });

    volumeControl?.addEventListener('input', (e) => {
      mainVideo.volume = e.target.value / 100;
    });

    // Time update
    mainVideo.addEventListener('timeupdate', () => {
      const currentTime = formatTime(mainVideo.currentTime);
      const totalTime = formatTime(mainVideo.duration);
      
      document.getElementById('current-time').textContent = currentTime;
      document.getElementById('total-time').textContent = totalTime;
    });

    function formatTime(seconds) {
      if (isNaN(seconds)) return '00:00';
      
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    // Automated workflow functionality
    let currentJobId = null;
    let processingInterval = null;

    // Upload and start processing
    document.getElementById('start-processing')?.addEventListener('click', async () => {
      if (!currentProject.videoFile) {
        alert('Please upload a video file first.');
        return;
      }

      const startButton = document.getElementById('start-processing');
      startButton.disabled = true;
      startButton.textContent = '🚀 Processing...';

      try {
        // Prepare form data
        const formData = new FormData();
        formData.append('video', currentProject.videoFile);
        formData.append('targetLanguage', document.getElementById('target-language').value);
        formData.append('voiceStyle', document.getElementById('voice-style')?.value || 'standard');
        formData.append('emotionIntensity', getEmotionLevel());
        formData.append('lipSyncAccuracy', document.getElementById('lip-sync-accuracy').value);
        formData.append('subtitlesEnabled', document.getElementById('enable-subtitles').checked);
        formData.append('regionalAccent', document.getElementById('regional-accent').value);
        formData.append('qualityPreset', document.getElementById('quality-preset').value);

        // Upload video and start processing
        const response = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (result.success) {
          currentJobId = result.data.jobId;
          currentProject.videoKey = result.data.videoKey; // Store video key
          showProcessingStatus();
          startProgressMonitoring();
          
          // Start analysis
          await startAnalysis();
        } else {
          alert(`Upload failed: ${result.error}`);
          resetStartButton();
        }
      } catch (error) {
        console.error('Processing error:', error);
        alert('Failed to start processing. Please try again.');
        resetStartButton();
      }
    });

    // Start analysis
    async function startAnalysis() {
      try {
        const response = await fetch('/api/analysis', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            videoKey: currentProject.videoKey,
            jobId: currentJobId
          })
        });

        const result = await response.json();
        
        if (result.success) {
          updateCharacterList(result.data.characters);
          updateProgress(25, 'Analysis completed');
        } else {
          console.error('Analysis failed:', result.error);
        }
      } catch (error) {
        console.error('Analysis error:', error);
      }
    }

    // Monitor processing progress
    function startProgressMonitoring() {
      processingInterval = setInterval(async () => {
        try {
          const response = await fetch(`/api/upload?jobId=${currentJobId}`);
          const result = await response.json();
          
          if (result.success) {
            updateProgressFromJob(result.data);
          }
        } catch (error) {
          console.error('Progress monitoring error:', error);
        }
      }, 2000);
    }

    // Update progress from job status
    function updateProgressFromJob(jobStatus) {
      const progress = jobStatus.overallProgress || 0;
      const currentTask = jobStatus.currentTask || 'Processing...';
      
      updateProgress(progress, currentTask);
      
      if (jobStatus.status === 'completed') {
        clearInterval(processingInterval);
        showCompletionStatus();
        performQualityControl();
      } else if (jobStatus.status === 'error') {
        clearInterval(processingInterval);
        showErrorStatus(jobStatus.error);
      }
    }

    // Show processing status
    function showProcessingStatus() {
      const statusElement = document.getElementById('processing-status');
      statusElement.classList.remove('hidden');
      
      updateProgress(0, 'Starting processing...');
    }

    // Update progress
    function updateProgress(percentage, currentTask) {
      const progressBar = document.getElementById('overall-progress');
      const percentageText = document.getElementById('overall-percentage');
      const currentStage = document.getElementById('current-stage');
      
      progressBar.style.width = `${percentage}%`;
      percentageText.textContent = `${percentage}%`;
      currentStage.textContent = currentTask;
      
      // Update stage indicators
      updateStageIndicators(percentage);
    }

    // Update stage indicators
    function updateStageIndicators(percentage) {
      const stages = ['upload', 'analysis', 'translation', 'synthesis', 'finalization'];
      const stageElements = stages.map(stage => document.getElementById(`stage-${stage}`));
      
      const stageIndex = Math.floor(percentage / 20);
      
      stageElements.forEach((element, index) => {
        if (index < stageIndex) {
          element.className = 'w-8 h-8 rounded-full bg-green-500 mx-auto mb-1 flex items-center justify-center text-xs';
        } else if (index === stageIndex) {
          element.className = 'w-8 h-8 rounded-full bg-purple-500 mx-auto mb-1 flex items-center justify-center text-xs';
        } else {
          element.className = 'w-8 h-8 rounded-full bg-gray-600 mx-auto mb-1 flex items-center justify-center text-xs';
        }
      });
    }

    // Show completion status
    function showCompletionStatus() {
      updateProgress(100, 'Processing completed!');
      
      // Enable download button
      const exportButton = document.getElementById('export-video');
      exportButton.disabled = false;
      exportButton.textContent = '📥 Download Dubbed Video';
      
      // Show success message
      showNotification('✅ Processing completed successfully!', 'success');
    }

    // Perform quality control
    async function performQualityControl() {
      try {
        const response = await fetch('/api/quality-control', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            jobId: currentJobId,
            videoKey: currentProject.videoKey,
            dubbedVideoKey: `dubbed_${currentJobId}`
          })
        });

        const result = await response.json();
        
        if (result.success) {
          showQualityReport(result.data);
        }
      } catch (error) {
        console.error('Quality control error:', error);
      }
    }

    // Show quality report
    function showQualityReport(report) {
      const qualityModal = createQualityModal(report);
      document.body.appendChild(qualityModal);
    }

    // Create quality modal
    function createQualityModal(report) {
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
      modal.innerHTML = `
        <div class="bg-gray-800 rounded-xl p-6 max-w-2xl w-full mx-4 max-h-[80vh] overflow-y-auto">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-white">Quality Control Report</h3>
            <button onclick="this.closest('.fixed').remove()" class="text-gray-400 hover:text-white">✕</button>
          </div>
          
          <div class="mb-4">
            <div class="flex items-center space-x-2 mb-2">
              <span class="text-white">Overall Score:</span>
              <span class="text-2xl font-bold ${report.passed ? 'text-green-400' : 'text-yellow-400'}">${Math.round(report.overallScore * 100)}%</span>
              <span class="px-2 py-1 rounded text-xs ${report.passed ? 'bg-green-600' : 'bg-yellow-600'} text-white">${report.passed ? 'PASSED' : 'NEEDS REVIEW'}</span>
            </div>
          </div>
          
          <div class="space-y-3 mb-4">
            ${report.checks.map(check => `
              <div class="bg-gray-700 rounded-lg p-3">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-white font-medium">${check.name}</span>
                  <span class="text-sm ${check.status === 'pass' ? 'text-green-400' : check.status === 'warning' ? 'text-yellow-400' : 'text-red-400'}">${Math.round(check.score * 100)}%</span>
                </div>
                <div class="w-full bg-gray-600 rounded-full h-2">
                  <div class="bg-gradient-to-r from-pink-500 to-purple-600 h-2 rounded-full" style="width: ${check.score * 100}%"></div>
                </div>
              </div>
            `).join('')}
          </div>
          
          ${report.recommendations.length > 0 ? `
            <div class="mb-4">
              <h4 class="text-white font-medium mb-2">Recommendations:</h4>
              <div class="space-y-2">
                ${report.recommendations.map(rec => `
                  <div class="bg-gray-700 rounded-lg p-3">
                    <div class="flex items-center justify-between mb-1">
                      <span class="text-white text-sm">${rec.description}</span>
                      <span class="px-2 py-1 rounded text-xs ${rec.priority === 'high' ? 'bg-red-600' : rec.priority === 'medium' ? 'bg-yellow-600' : 'bg-blue-600'} text-white">${rec.priority.toUpperCase()}</span>
                    </div>
                    <div class="text-gray-400 text-xs">Estimated effort: ${rec.estimatedEffort}</div>
                  </div>
                `).join('')}
              </div>
            </div>
          ` : ''}
        </div>
      `;
      
      return modal;
    }

    // Export functionality
    document.getElementById('export-video')?.addEventListener('click', async () => {
      if (!currentJobId) {
        alert('Please complete the dubbing process first.');
        return;
      }

      try {
        const response = await fetch('/api/download', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            jobId: currentJobId,
            includeSubtitles: true,
            format: 'mp4'
          })
        });

        const result = await response.json();
        
        if (result.success) {
          // Create download link
          const downloadLink = document.createElement('a');
          downloadLink.href = result.data.downloadUrl;
          downloadLink.download = result.data.filename;
          document.body.appendChild(downloadLink);
          downloadLink.click();
          document.body.removeChild(downloadLink);
          
          showNotification('📥 Download started!', 'success');
        } else {
          alert(`Download failed: ${result.error}`);
        }
      } catch (error) {
        console.error('Download error:', error);
        alert('Failed to download video. Please try again.');
      }
    });

    // Save project
    document.getElementById('save-project')?.addEventListener('click', () => {
      const projectData = JSON.stringify({
        ...currentProject,
        jobId: currentJobId
      });
      localStorage.setItem('anidub_project', projectData);
      showNotification('💾 Project saved successfully!', 'success');
    });

    // Helper functions
    function getEmotionLevel() {
      const intensity = document.getElementById('emotion-intensity').value;
      const levels = ['low', 'medium', 'high', 'ultra'];
      return levels[parseInt(intensity) - 1];
    }

    function resetStartButton() {
      const startButton = document.getElementById('start-processing');
      startButton.disabled = false;
      startButton.textContent = '🚀 Start Dubbing Process';
    }

    function showErrorStatus(error) {
      updateProgress(0, `Error: ${error}`);
      showNotification(`❌ Processing failed: ${error}`, 'error');
      resetStartButton();
    }

    function showNotification(message, type = 'info') {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 p-4 rounded-lg text-white z-50 ${
        type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-blue-600'
      }`;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.remove();
      }, 5000);
    }

    function updateCharacterList(characters) {
      const characterList = document.getElementById('character-list');
      
      if (characters && characters.length > 0) {
        characterList.innerHTML = characters.map(char => `
          <div class="bg-white bg-opacity-10 rounded-lg p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-white font-semibold">${char.name}</span>
              <span class="text-purple-400 text-sm">${char.voiceStyle}</span>
            </div>
            <div class="text-gray-400 text-sm mb-2">${char.personality.join(', ')}</div>
            <div class="flex items-center space-x-1">
              <span class="bg-blue-600 text-white text-xs px-2 py-1 rounded">${char.gender}</span>
              <span class="bg-green-600 text-white text-xs px-2 py-1 rounded">${char.age}</span>
              <span class="bg-purple-600 text-white text-xs px-2 py-1 rounded">${char.voiceId}</span>
            </div>
          </div>
        `).join('');
      }
    }
  });
</script>

