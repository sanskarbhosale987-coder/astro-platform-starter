# AniDub AI Environment Configuration
# Copy this file to .env and fill in your actual API keys and settings

# ======================
# AI Service API Keys
# ======================

# OpenAI API Key (for translation and text processing)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (for voice synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Cloud Translation API Key
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# ======================
# Application Settings
# ======================

# Application Environment
NODE_ENV=development

# Server Configuration
PORT=4321
HOST=localhost

# ======================
# Processing Configuration
# ======================

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE=500

# Processing timeout (in seconds)
PROCESSING_TIMEOUT=3600

# Maximum concurrent batch jobs
MAX_CONCURRENT_JOBS=3

# Temporary files directory
TEMP_DIR=./temp

# ======================
# Audio/Video Processing
# ======================

# FFmpeg binary path (leave empty to use system PATH)
FFMPEG_PATH=

# Default audio sample rate
DEFAULT_SAMPLE_RATE=44100

# Default audio bit rate
DEFAULT_BIT_RATE=128000

# ======================
# Voice Synthesis Settings
# ======================

# Default voice model
DEFAULT_VOICE_MODEL=eleven_multilingual_v2

# Voice synthesis quality (standard, high_quality)
DEFAULT_VOICE_QUALITY=standard

# ======================
# Translation Settings
# ======================

# Default translation provider (openai, google)
DEFAULT_TRANSLATION_PROVIDER=openai

# Translation cache enabled
TRANSLATION_CACHE_ENABLED=true

# ======================
# Lip Sync Settings
# ======================

# Default lip sync accuracy (standard, high, ultra)
DEFAULT_LIPSYNC_ACCURACY=high

# Phoneme detection model
PHONEME_MODEL=default

# ======================
# Subtitle Settings
# ======================

# Default subtitle format (srt, vtt, ass)
DEFAULT_SUBTITLE_FORMAT=srt

# Subtitle styling enabled
SUBTITLE_STYLING_ENABLED=true

# ======================
# Database Configuration (if using)
# ======================

# Database URL (for production use)
# DATABASE_URL=postgresql://username:password@localhost:5432/anidub

# Redis URL (for caching)
# REDIS_URL=redis://localhost:6379

# ======================
# Security Settings
# ======================

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_here

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# ======================
# Logging Configuration
# ======================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/anidub.log

# ======================
# Performance Settings
# ======================

# Enable GPU acceleration (if available)
GPU_ACCELERATION=false

# Memory limit for processing (in MB)
MEMORY_LIMIT=2048

# CPU cores to use for processing
CPU_CORES=4

# ======================
# Feature Flags
# ======================

# Enable batch processing
BATCH_PROCESSING_ENABLED=true

# Enable custom voice training
CUSTOM_VOICE_TRAINING_ENABLED=true

# Enable real-time preview
REALTIME_PREVIEW_ENABLED=true

# Enable subtitle generation
SUBTITLE_GENERATION_ENABLED=true

# ======================
# Monitoring & Analytics
# ======================

# Enable usage analytics
ANALYTICS_ENABLED=false

# Analytics service URL
# ANALYTICS_URL=https://analytics.example.com

# Error reporting service
# ERROR_REPORTING_URL=https://errors.example.com